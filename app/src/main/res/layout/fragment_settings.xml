<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true">

    <RelativeLayout
        android:id="@+id/font_control_p"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/menu_item_height"
        android:clickable="true"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/ff_control"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:background="@drawable/border"
            android:visibility="visible">

            <SeekBar
                android:id="@+id/font_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:max="200"
                android:maxHeight="6dp"
                android:progress="40"
                android:progressDrawable="@drawable/progress_style"
                android:thumb="@drawable/progress_thumb_drawable" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnHideFontControl"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_above="@id/ff_control"
            android:layout_alignRight="@id/ff_control"
            android:layout_gravity="center|right"
            android:background="@drawable/border"
            android:clickable="true"
            android:padding="5dp"
            android:src="@drawable/close_unclick" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_gravity="left|top"
        android:layout_marginBottom="@dimen/menu_item_height"
        android:background="@drawable/border">

        <LinearLayout
            android:id="@+id/menuList"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClose"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:drawableLeft="@drawable/ic_back"
                android:drawablePadding="8dp"
                android:gravity="left|center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/dialog_close"
                android:textSize="@dimen/menu_item_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <LinearLayout
                android:id="@+id/menu_ftp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="@dimen/menu_item_height"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/ftp_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_cloud_manager_wifi_off"
                    android:textSize="@dimen/menu_item_text_size"
                    tools:text="网络传书 （开）" />

                <TextView
                    android:id="@+id/ftp_addr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    tools:text="ftp://192.168.123.121" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingRight="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/setting_row_icons"
                    android:textSize="@dimen/menu_item_text_size" />

                <Spinner
                    android:id="@+id/col_num_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:entries="@array/col_num_values"
                    android:gravity="center" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingRight="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/setting_column_icons"
                    android:textSize="@dimen/menu_item_text_size" />

                <Spinner
                    android:id="@+id/row_num_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:entries="@array/col_num_values"
                    android:gravity="center" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingRight="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/app_show_name"
                    android:textSize="@dimen/menu_item_text_size" />

                <Spinner
                    android:id="@+id/appNameLine"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:entries="@array/app_name_line"
                    android:gravity="center" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:orientation="horizontal"
                android:paddingLeft="20dp"
                android:paddingRight="10dp"
                android:id="@+id/ll_sort">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/app_sort_name"
                    android:textSize="@dimen/menu_item_text_size" />

                <Spinner
                    android:id="@+id/appSort"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:entries="@array/app_name_sort"
                    android:gravity="center" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/hideDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:gravity="left|center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/setting_show_divider"
                android:textSize="@dimen/menu_item_text_size"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/showStatusBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:gravity="left|center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/show_status_bar"
                android:textSize="@dimen/menu_item_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/showWifiName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:gravity="left|center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/show_wifi_name"
                android:textSize="@dimen/menu_item_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/showCustomIcon"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:gravity="left|center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/show_custom_icon"
                android:textSize="@dimen/menu_item_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/changeFontSize"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/setting_set_font_size"
                android:textSize="@dimen/menu_item_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/deleteApp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/setting_apps_manager"
                android:textSize="@dimen/menu_item_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/openDeviceManager"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/setting_open_device_manager"
                android:textSize="@dimen/menu_item_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/helpAbout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_item_height"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:text="@string/setting_help_and_about"
                android:textSize="@dimen/menu_item_text_size" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>